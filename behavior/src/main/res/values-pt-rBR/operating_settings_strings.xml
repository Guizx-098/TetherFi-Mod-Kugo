<resources>
  <string name="operating_settings">Configurações de funcionamento</string>
  <string name="operating_always_alive_title">Sempre ativo</string>
  <string name="operating_always_alive_description">Permite que o Hotspot do %1$s continue funcionando mesmo com o app fechado.\n\nIsso melhora bastante a sua experiência e o desempenho da rede.\n(recomendado)</string>
  <string name="permission_notification_title">Mostrar notificação do Hotspot</string>
  <string name="permission_notification_description">Mantém o Hotspot ativo em versões mais novas do Android.\n\nSem uma notificação, o Hotspot pode ser encerrado aleatoriamente.</string>
  <string name="operating_new_engine_title">Usar o novo mecanismo</string>
  <string name="operating_new_engine_description">Faz o %1$s usar um novo mecanismo de proxy baseado em Netty para tratar as conexões. Este novo mecanismo é o padrão atual e será o único com suporte na próxima versão.</string>
</resources>
